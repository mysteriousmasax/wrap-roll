# Leave blank for local Vite proxy development.
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_GOOGLE_MAPS_API_KEY=
PUBLIC_APP_URL=https://wrapandrolltz.com

# Signed Windows desktop release shown in Admin Settings.
# Publish the NSIS artifact to a trusted release host before setting these values.
DESKTOP_POS_DOWNLOAD_URL=
DESKTOP_POS_VERSION=
DESKTOP_POS_SHA256=
DESKTOP_POS_SIZE=

# API runtime settings
PORT=3001
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# Server-side Gemini customer-chat fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional comma-separated fallback models for temporary provider errors
GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash-lite,gemini-2.5-flash
# Email delivery: configure Resend API or the SMTP fallback
RESEND_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_NAME="Wrap & Roll"
EMAIL_FROM_ADDRESS=noreply@wrapandrolltz.com
EMAIL_REPLY_TO=info@wrapandrolltz.com
EMAIL_POSTAL_ADDRESS="Wrap & Roll, Wikicha Tower, Mwai Kibaki Road, Dar es Salaam, Tanzania"
EMAIL_DKIM_SELECTOR=
EMAIL_HELO_DOMAIN=
EMAIL_SENDING_IP=
EMAIL_WEBHOOK_SECRET=
# Meta WhatsApp Cloud API and Instagram Messaging API credentials
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
META_GRAPH_API_VERSION=v23.0
# Production must point this at a persistent volume, for example /data/wraproll.db.
DB_PATH=

VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_TILE_ATTRIBUTION=
VITE_GOOGLE_MAPS_API_KEY=
# JSON array of the real customer-facing payment accounts. Do not use example numbers.
# Example shape: [{"network":"Mixx by Yas","number":"...","name":"Megamore","ussd":"*150*01#"}]
LIPA_ACCOUNTS_JSON=[]

# Hosted website and local POS should use the same reachable API, for example:
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com/ws

# PESAPAL PAYMENT GATEWAY CONFIGURATION
# Sign up at https://www.pesapal.com to get these credentials
PESAPAL_API_URL=https://api.pesapal.com/api/v3
PESAPAL_CONSUMER_KEY=your_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_consumer_secret_here
PESAPAL_API_KEY=your_api_key_here
PESAPAL_SECRET_KEY=your_secret_key_here

# PAYMENT FEATURES
ENABLE_CARD_PAYMENTS=true
ENABLE_MOBILE_MONEY=true
ENABLE_BANK_TRANSFERS=true
ENABLE_CASH_PAYMENTS=true
ENABLE_REFUNDS=true

# ROMESON RBP58 ESC/POS PRINTER
# For paired Bluetooth on Windows, set the printer's COM port, for example COM7.
PRINTER_TRANSPORT=serial
PRINTER_PATH=COM7
PRINTER_BAUD_RATE=9600
# For a network ESC/POS printer instead:
# PRINTER_TRANSPORT=tcp
# PRINTER_HOST=192.168.1.50
# PRINTER_PORT=9100