{
  "name": "wrap-roll-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "vite build",
    "desktop:dev": "npm run build && electron electron/main.cjs",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "start": "node server/index.js",
    "preview": "vite preview",
    "seed": "node server/scripts/seedDatabase.js",
    "seed:fresh": "node server/scripts/seedDatabase.js",
    "refresh:docs": "node server/scripts/refreshDocumentData.js",
    "postinstall": "npm install --prefix server"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.441.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.41",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.9",
    "vite": "^5.4.0"
  },
  "overrides": {
    "better-sqlite3": "^13.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "build": {
    "appId": "tz.wrapandroll.pos",
    "productName": "Wrap & Roll POS",
    "asar": true,
    "disableDefaultIgnoredFiles": true,
    "icon": "public/wrap-roll-logo.ico",
    "asarUnpack": [
      "server/**/*",
      "server/node_modules/**/*",
      "node_modules/better-sqlite3/**",
      "server/node_modules/better-sqlite3/**"
    ],
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "server/node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Wrap-Roll-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wrap & Roll POS"
    }
  }
}
